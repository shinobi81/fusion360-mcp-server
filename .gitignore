__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# coverage artefacts
.coverage
.coverage.*
htmlcov/

# OS noise
.DS_Store
Thumbs.db
*.log

# local editor / environment files
.env
.vscode/

.worktrees

# local planning notes — design/spec docs and the SDD ledger stay out of the repo
.superpowers/
docs/superpowers/

# review/PR scratch files: a 'git add -A' must not swallow these.
# The pattern is deliberately broad: a review pass also writes `.pr_pass1…` and
# `.pr_evidence…`, and narrower ones (`*.pr_body*`) have let files through. It covers
# any `.pr-`/`.pr_` path at any depth, not only the review's, so a future verbatim file
# of that shape must be force-added rather than silently tracked.
.review-diff*
.pr[-_]*
