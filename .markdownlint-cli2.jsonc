{
  // The docs are tool catalogues with wide tables, so markdownlint's defaults
  // fight them: MD013 would demand 80-column tables, and MD060 only asks for
  // pipe alignment. Prose is wrapped at 88 to match ruff's line-length.
  // A pull request template is a fragment, not a document: it has no H1.
  // The two superpowers paths are git-ignored local scratch — `docs/superpowers/` and
  // `.superpowers/` are both in .gitignore — so CI never checks them out and the local
  // gate must not lint them.
  "ignores": [
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".superpowers",
    "docs/superpowers"
  ],
  "config": {
    "default": true,
    "MD013": { "line_length": 88, "tables": false, "code_blocks": false },
    "MD060": false,
    // A changelog repeats "Added"/"Fixed"/"Changed" under every version.
    "MD024": { "siblings_only": true },
    "MD033": false
  }
}
